{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"]
  },
  "include": ["src"],
  // The Worker entry runs in a Worker: tsconfig.worker.json checks it with the Worker's types;
  // the build's own files run in Node: tsconfig.node.json checks them.
  "exclude": ["src/worker/entry.ts"]
}
